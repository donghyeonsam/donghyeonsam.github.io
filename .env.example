# Copy to .env and fill in to sync TIL / Tech Logs from Notion locally
# (npm run sync:notion). In CI, set the same names as GitHub Actions repo
# secrets instead — see .github/workflows/deploy.yml.

# Notion integration token: notion.so/my-integrations → your integration → secret
NOTION_TOKEN=

# Each database's id is the 32-char segment in its Notion URL
# (dashes optional). Share both databases with the integration above.
NOTION_TIL_DATABASE_ID=
NOTION_TECHLOGS_DATABASE_ID=
