node_modules
dist
dist-ssr
*.local
.env
.env.*
!.env.example

# TypeScript incremental build cache + compiled output of vite.config.ts
# (tsconfig.node.json has no outDir, so tsc drops these next to the source)
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Vite's dep pre-bundling cache (normally under node_modules/.vite, but can
# land at the project root too)
.vite

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
